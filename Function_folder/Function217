public class Function217 {

    static class Node {
        int data;
        Node left, right;

        Node(int data) {
            this.data = data;
        }
    }

    static int sumPositiveNodes(Node root) {

        // Base case
        if (root == null) {
            return 0;
        }

        int sum = 0;

        // Check if the value is positive
        if (root.data > 0) {
            System.out.print(root.data + " ");
            sum = root.data;
        }

        // Traverse left and right subtrees
        sum += sumPositiveNodes(root.left);
        sum += sumPositiveNodes(root.right);

        return sum;
    }

    public static void main(String[] args) {

        Node root = new Node(10);

        root.left = new Node(-5);
        root.right = new Node(8);

        root.left.left = new Node(4);
        root.left.right = new Node(-7);

        root.right.right = new Node(6);

        System.out.print("Positive Nodes: ");

        int result = sumPositiveNodes(root);

        System.out.println("\nSum of Positive Nodes: " + result);
    }
}