public class Function212 {

    static class Node {
        int data;
        Node left, right;

        Node(int data) {
            this.data = data;
        }
    }

    static int sumEvenNodes(Node root) {

        // Base case
        if (root == null) {
            return 0;
        }

        int sum = 0;

        // Check if the value is even
        if (root.data % 2 == 0) {
            System.out.print(root.data + " ");
            sum = root.data;
        }

        // Traverse left and right subtrees
        sum += sumEvenNodes(root.left);
        sum += sumEvenNodes(root.right);

        return sum;
    }

    public static void main(String[] args) {

        Node root = new Node(10);

        root.left = new Node(5);
        root.right = new Node(8);

        root.left.left = new Node(4);
        root.left.right = new Node(7);

        root.right.right = new Node(6);

        System.out.print("Even Nodes: ");

        int result = sumEvenNodes(root);

        System.out.println("\nSum of Even Nodes: " + result);
    }
}